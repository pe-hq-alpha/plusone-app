# Frontend (written by `npx convex dev` into .env.local)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Clerk: the app's publishable key (pk_test_… in development)
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: usage events from the app
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Backend env vars are set on the Convex deployment, not in this file:
#   npx convex env set ANTHROPIC_API_KEY=
#   npx convex env set FIRECRAWL_API_KEY=
#   npx convex env set AGENTMAIL_API_KEY=
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET=
#   npx convex env set AGENTMAIL_INBOX_DOMAIN=
#   npx convex env set SITE_URL=
#   npx convex env set RESEND_API_KEY=
#   npx convex env set EMAIL_FROM=
#   npx convex env set EMAIL_UNSUBSCRIBE_SECRET=
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN=   (your Clerk Frontend API, e.g. https://clerk.example.com)
#   JWT_PRIVATE_KEY and JWKS: keys for the demo's guest tokens (Convex Auth)
# Optional: ANTHROPIC_MODEL_SMART, ANTHROPIC_MODEL_FAST, AGENTMAIL_FALLBACK_INBOX_ID,
#   AGENTMAIL_INBOX_LIMIT, AGENTMAIL_POD_ID, EMAIL_LIVE (1 to send app emails),
#   POSTHOG_KEY, POSTHOG_HOST
